+/// Stores the x coordinate, y coordinate, width dimension and height dimension of the rectangle, in that order.
+///
+/// # Safety
+///
+/// `rect` must be the live cell of a DOMRectReadOnly or a DOMRect.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn web_dom_rect_read_only_dimensions(rect: *mut c_void, out_dimensions: &mut [f64; 4]) {
