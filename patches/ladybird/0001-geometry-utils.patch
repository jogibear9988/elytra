+/// The rectangle of a DOMRectReadOnly or a DOMRect whose cell C++ lends.
+///
+/// # Safety
+///
+/// `cell` must be the live cell of a DOMRectReadOnly or a DOMRect, and it must outlive `'a`.
+unsafe fn rect_from_abi<'a>(cell: *mut c_void) -> &'a DOMRectReadOnly {
+    // SAFETY: The caller passes a live cell.
+    if let Some(rect) = unsafe { cell_if_abi::<DOMRectReadOnly>(cell) } {
+        // SAFETY: The caller keeps the cell alive for 'a.
+        return unsafe { &*rect.as_ptr() };
+    }
+    // SAFETY: The caller passes the cell of a DOMRect, which it keeps alive for 'a.
+    unsafe { object_from_abi::<DOMRect>(cell) }.parent()
+}
