+
+namespace Web::FileSystemAccess {
+
+class FileSystemHandle : public Bindings::GCAllocatedWrappable {
+    WEB_WRAPPABLE(FileSystemHandle, Bindings::GCAllocatedWrappable);
+
+public:
+    static GC::Ptr<FileSystemHandle> from_grant(DOM::Document&, JsonObject const&);
+
+    Bindings::FileSystemHandleKind kind() const
+    {
+        return m_kind;
+    }
+
+    Utf16String const& name() const
+    {
+        return m_name;
+    }
+
+    WebIDL::ExceptionOr<void> is_same_entry(FileSystemHandle const&, GC::Ref<WebIDL::Promise>);
+
+    Optional<String> token_for(DOM::Document const& document) const
+    {
+        if (&document != m_document.ptr())
+            return {};
+        return m_token;
+    }
+
+    WebIDL::ExceptionOr<void> request_permission(
+        Bindings::FileSystemHandlePermissionDescriptor const&, GC::Ref<WebIDL::Promise>);
+
+    WebIDL::ExceptionOr<void> query_permission(
+        Bindings::FileSystemHandlePermissionDescriptor const&, GC::Ref<WebIDL::Promise>);
+
+protected:
+    friend class FileSystemDirectoryHandle;
+
+    FileSystemHandle(DOM::Document&, String, Utf16String, Bindings::FileSystemHandleKind);
+
+    virtual void visit_edges(GC::Cell::Visitor&) override;
+    virtual void finalize() override;
+
+    DOM::Document& document() const
+    {
+        return *m_document;
+    }
+
+    String const& token() const
+    {
+        return m_token;
+    }
+
+private:
+    WebIDL::ExceptionOr<void> permission_operation(StringView,
+        Bindings::FileSystemHandlePermissionDescriptor const&, GC::Ref<WebIDL::Promise>);
+
+    GC::Ref<DOM::Document> m_document;
+    GC::Weak<DOM::Document> m_weak_document;
+    String m_token;
+    Utf16String m_name;
+    Bindings::FileSystemHandleKind m_kind;
+};
+
