@@ -0,0 +1,319 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/JsonArray.h>
+#include <LibCore/EventLoop.h>
+#include <LibGC/Heap.h>
+#include <LibGC/Root.h>
+#include <LibGC/RootVector.h>
+#include <LibJS/Runtime/Array.h>
+#include <LibJS/Runtime/PrimitiveString.h>
+#include <LibWeb/Bindings/FileSystemDirectoryHandle.h>
+#include <LibWeb/Bindings/FileSystemPickerOptions.h>
+#include <LibWeb/Bindings/WrapperWorld.h>
+#include <LibWeb/DOM/Document.h>
+#include <LibWeb/FileAPI/File.h>
+#include <LibWeb/FileSystemAccess/FileSystemDirectoryHandle.h>
+#include <LibWeb/FileSystemAccess/FileSystemFileHandle.h>
+#include <LibWeb/FileSystemAccess/Provider.h>
+#include <LibWeb/HTML/Scripting/TemporaryExecutionContext.h>
+#include <LibWeb/WebIDL/DOMException.h>
+
+namespace Web::FileSystemAccess {
+
+GC_DEFINE_ALLOCATOR(FileSystemDirectoryHandle);
+GC_DEFINE_ALLOCATOR(FileSystemFileHandle);
+
+FileSystemHandle::FileSystemHandle(
+    DOM::Document& document, String token, Utf16String name, Bindings::FileSystemHandleKind kind)
+    : m_document(document)
+    , m_weak_document(document)
+    , m_token(move(token))
+    , m_name(move(name))
+    , m_kind(kind)
+{
+}
+
+void FileSystemHandle::visit_edges(GC::Cell::Visitor& visitor)
+{
+    Base::visit_edges(visitor);
+    visitor.visit(m_document);
+}
+
+void FileSystemHandle::finalize()
+{
+    // GC finalization cannot enter the JavaScript VM or create new roots.
+    // Drop native leases from the event loop while the document is still live.
+    if (Core::EventLoop::is_running()) {
+        Core::deferred_invoke([document = move(m_weak_document), token = move(m_token)] {
+            auto target = document.ptr();
+            if (!target || !target->is_fully_active())
+                return;
+
+            JsonObject options;
+            options.set("operation"sv, "release"sv);
+            options.set("token"sv, token);
+            request(*target, move(options), [](JsonObject, ByteBuffer) { });
+        });
+    }
+    Base::finalize();
+}
+
+GC::Ptr<FileSystemHandle> FileSystemHandle::from_grant(
+    DOM::Document& document, JsonObject const& metadata)
+{
+    auto name = metadata.get_string("name"sv);
+    auto token = metadata.get_string("token"sv);
+    auto kind = metadata.get_string("kind"sv);
+    if (!name.has_value() || !token.has_value() || !kind.has_value())
+        return nullptr;
+
+    auto& heap = GC::Heap::the();
+    if (*kind == "file"sv)
+        return heap.allocate<FileSystemFileHandle>(document, *token, Utf16String::from_utf8(*name));
+    if (*kind == "directory"sv)
+        return heap.allocate<FileSystemDirectoryHandle>(
+            document, *token, Utf16String::from_utf8(*name));
+    return nullptr;
+}
+
+FileSystemFileHandle::FileSystemFileHandle(DOM::Document& document, String token, Utf16String name)
+    : FileSystemHandle(document, move(token), move(name), Bindings::FileSystemHandleKind::File)
+{
+}
+
+FileSystemDirectoryHandle::FileSystemDirectoryHandle(
+    DOM::Document& document, String token, Utf16String name)
+    : FileSystemHandle(document, move(token), move(name), Bindings::FileSystemHandleKind::Directory)
+{
+}
+
+struct FileSnapshot {
+    ByteBuffer contents;
+    Optional<String> revision;
+    Utf16String type;
+    i64 last_modified { 0 };
+};
+
+static void read_file(GC::Root<FileSystemFileHandle> handle, DOM::Document& document, String token,
+    GC::Root<WebIDL::Promise> promise, FileSnapshot snapshot)
+{
+    constexpr size_t chunk_size = 256 * 1024;
+    constexpr size_t maximum_file_size = 16 * 1024 * 1024;
+    JsonObject options;
+    options.set("operation"sv, "read"sv);
+    options.set("token"sv, token);
+    options.set("offset"sv, static_cast<u64>(snapshot.contents.size()));
+    options.set("count"sv, static_cast<u64>(chunk_size));
+    request(document, move(options),
+        [handle = move(handle), &document, token = move(token), promise = move(promise),
+            snapshot = move(snapshot)](JsonObject result, ByteBuffer bytes) mutable {
+            if (reject_if_failed(*promise, result))
+                return;
+            auto revision = result.get_string("revision"sv);
+            auto modified = result.get_i64("lastModified"sv);
+            if (!revision.has_value() || !modified.has_value()
+                || (snapshot.revision.has_value() && *snapshot.revision != *revision)) {
+                reject(*promise, "NotReadableError"sv);
+                return;
+            }
+
+            if (!snapshot.revision.has_value()) {
+                snapshot.revision = *revision;
+                snapshot.last_modified = *modified;
+                if (auto type = result.get_string("type"sv); type.has_value())
+                    snapshot.type = Utf16String::from_utf8(*type);
+            }
+
+            if (bytes.size() > chunk_size
+                || snapshot.contents.size() + bytes.size() > maximum_file_size
+                || snapshot.contents.try_append(bytes.bytes()).is_error()) {
+                reject(*promise, "QuotaExceededError"sv);
+                return;
+            }
+
+            if (bytes.size() == chunk_size) {
+                read_file(move(handle), document, move(token), move(promise), move(snapshot));
+                return;
+            }
+
+            auto& realm = WebIDL::promise_realm(*promise);
+            HTML::TemporaryExecutionContext context(realm);
+            auto file = FileAPI::File::create(snapshot.contents.bytes(), handle->name(),
+                move(snapshot.type), snapshot.last_modified);
+            WebIDL::resolve_promise(
+                *promise, Bindings::wrap(Bindings::host_defined_wrapper_world(realm), realm, file));
+        });
+}
+
+WebIDL::ExceptionOr<void> FileSystemFileHandle::get_file(GC::Ref<WebIDL::Promise> promise)
+{
+    read_file(GC::Root { *this }, document(), token(), GC::Root { promise }, {});
+    return {};
+}
+
+WebIDL::ExceptionOr<void> FileSystemDirectoryHandle::get_directory_handle(Utf16String const& name,
+    Bindings::FileSystemGetDirectoryOptions const& options, GC::Ref<WebIDL::Promise> promise)
+{
+    return child(name, "directory"sv, options.create, promise);
+}
+
+WebIDL::ExceptionOr<void> FileSystemDirectoryHandle::get_file_handle(Utf16String const& name,
+    Bindings::FileSystemGetFileOptions const& options, GC::Ref<WebIDL::Promise> promise)
+{
+    return child(name, "file"sv, options.create, promise);
+}
+
+WebIDL::ExceptionOr<void> FileSystemDirectoryHandle::child(
+    Utf16String const& name, StringView kind, bool create, GC::Ref<WebIDL::Promise> promise)
+{
+    JsonObject options;
+    options.set("operation"sv, "child"sv);
+    options.set("token"sv, token());
+    options.set("kind"sv, kind);
+    options.set("create"sv, create);
+    options.set("name"sv, name.to_well_formed_utf8());
+    request(document(), move(options),
+        [document = GC::Root { document() }, promise = GC::Root { promise }](
+            JsonObject result, ByteBuffer) {
+            if (reject_if_failed(*promise, result))
+                return;
+
+            auto handle = from_grant(*document, result);
+            if (!handle) {
+                reject(*promise, "UnknownError"sv);
+                return;
+            }
+
+            auto& realm = WebIDL::promise_realm(*promise);
+            HTML::TemporaryExecutionContext context(realm);
+            WebIDL::resolve_promise(*promise,
+                Bindings::wrap(
+                    Bindings::host_defined_wrapper_world(realm), realm, GC::Ref { *handle }));
+        });
+    return {};
+}
+
+WebIDL::ExceptionOr<void> FileSystemHandle::is_same_entry(
+    FileSystemHandle const& other, GC::Ref<WebIDL::Promise> promise)
+{
+    if (&document() != &other.document()) {
+        WebIDL::resolve_promise(*promise, JS::Value(false));
+        return {};
+    }
+
+    JsonObject options;
+    options.set("operation"sv, "sameEntry"sv);
+    options.set("token"sv, token());
+    options.set("other"sv, other.token());
+    request(
+        document(), move(options), [promise = GC::Root { promise }](JsonObject result, ByteBuffer) {
+            if (reject_if_failed(*promise, result))
+                return;
+
+            if (auto same = result.get_bool("same"sv); same.has_value())
+                WebIDL::resolve_promise(*promise, JS::Value(*same));
+            else
+                reject(*promise, "UnknownError"sv);
+        });
+    return {};
+}
+
+WebIDL::ExceptionOr<void> FileSystemHandle::query_permission(
+    Bindings::FileSystemHandlePermissionDescriptor const& descriptor,
+    GC::Ref<WebIDL::Promise> promise)
+{
+    return permission_operation("queryPermission"sv, descriptor, promise);
+}
+
+WebIDL::ExceptionOr<void> FileSystemHandle::request_permission(
+    Bindings::FileSystemHandlePermissionDescriptor const& descriptor,
+    GC::Ref<WebIDL::Promise> promise)
+{
+    return permission_operation("requestPermission"sv, descriptor, promise);
+}
+
+WebIDL::ExceptionOr<void> FileSystemHandle::permission_operation(StringView operation,
+    Bindings::FileSystemHandlePermissionDescriptor const& descriptor,
+    GC::Ref<WebIDL::Promise> promise)
+{
+    JsonObject options;
+    options.set("operation"sv, operation);
+    options.set("token"sv, token());
+    options.set("writable"sv, descriptor.mode == Bindings::FileSystemPermissionMode::Readwrite);
+    request(
+        document(), move(options), [promise = GC::Root { promise }](JsonObject result, ByteBuffer) {
+            if (reject_if_failed(*promise, result))
+                return;
+
+            auto permission = result.get_string("permission"sv);
+            if (!permission.has_value()) {
+                reject(*promise, "UnknownError"sv);
+                return;
+            }
+
+            auto& realm = WebIDL::promise_realm(*promise);
+            WebIDL::resolve_promise(*promise,
+                JS::PrimitiveString::create(realm.vm(), Utf16String::from_utf8(*permission)));
+        });
+    return {};
+}
+
+WebIDL::ExceptionOr<void> FileSystemDirectoryHandle::remove_entry(Utf16String const& name,
+    Bindings::FileSystemRemoveOptions const& options, GC::Ref<WebIDL::Promise> promise)
+{
+    JsonObject metadata;
+    metadata.set("operation"sv, "remove"sv);
+    metadata.set("token"sv, token());
+    metadata.set("name"sv, name.to_well_formed_utf8());
+    metadata.set("recursive"sv, options.recursive);
+    request(document(), move(metadata),
+        [promise = GC::Root { promise }](JsonObject result, ByteBuffer) {
+            if (!reject_if_failed(*promise, result))
+                WebIDL::resolve_promise(*promise);
+        });
+    return {};
+}
+
+WebIDL::ExceptionOr<void> FileSystemDirectoryHandle::resolve(
+    FileSystemHandle const& other, GC::Ref<WebIDL::Promise> promise)
+{
+    if (&document() != &other.document()) {
+        WebIDL::resolve_promise(*promise, JS::js_null());
+        return {};
+    }
+
+    JsonObject options;
+    options.set("operation"sv, "resolve"sv);
+    options.set("token"sv, token());
+    options.set("other"sv, other.token());
+    request(
+        document(), move(options), [promise = GC::Root { promise }](JsonObject result, ByteBuffer) {
+            if (reject_if_failed(*promise, result))
+                return;
+
+            auto path = result.get_array("path"sv);
+            if (!path.has_value()) {
+                WebIDL::resolve_promise(*promise, JS::js_null());
+                return;
+            }
+
+            auto& realm = WebIDL::promise_realm(*promise);
+            GC::RootVector<JS::Value> components;
+            for (size_t i = 0; i < path->size(); ++i) {
+                auto const& component = path->at(i);
+                if (!component.is_string()) {
+                    reject(*promise, "UnknownError"sv);
+                    return;
+                }
+
+                components.append(JS::PrimitiveString::create(
+                    realm.vm(), Utf16String::from_utf8(component.as_string())));
+            }
+            WebIDL::resolve_promise(*promise, JS::Array::create_from(realm, components.span()));
+        });
+    return {};
+}
+
+}
diff --git a/Libraries/LibWeb/FileSystemAccess/Pickers.cpp b/Libraries/LibWeb/FileSystemAccess/Pickers.cpp
new file mode 100644
index 00000000000..ef4a097f05a
--- /dev/null
+++ b/Libraries/LibWeb/FileSystemAccess/Pickers.cpp
@@ -0,0 +1,233 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/CharacterTypes.h>
+#include <AK/JsonArray.h>
+#include <LibGC/Root.h>
+#include <LibJS/Runtime/Array.h>
+#include <LibWeb/Bindings/FileSystemPickerOptions.h>
+#include <LibWeb/Bindings/WrapperWorld.h>
+#include <LibWeb/DOM/Document.h>
+#include <LibWeb/FileSystemAccess/FileSystemHandle.h>
+#include <LibWeb/FileSystemAccess/Provider.h>
+#include <LibWeb/HTML/Scripting/Environments.h>
+#include <LibWeb/HTML/Scripting/TemporaryExecutionContext.h>
+#include <LibWeb/HTML/Window.h>
+#include <LibWeb/WebIDL/DOMException.h>
+#include <LibWeb/WebIDL/QuotaExceededError.h>
+#include <LibWebCommon/MimeSniff/MimeType.h>
+
+namespace Web::HTML {
+namespace {
+    WebIDL::ExceptionOr<void> check_picker(Window const& window, Optional<Utf16String> const& id)
+    {
+        if (id.has_value()) {
+            auto view = id->utf16_view();
+            if (view.length_in_code_units() > 32)
+                return WebIDL::SimpleException { WebIDL::SimpleExceptionType::TypeError,
+                    "Invalid file picker ID"_utf16 };
+            for (size_t i = 0; i < view.length_in_code_units(); ++i) {
+                auto c = view.code_unit_at(i);
+                if (!is_ascii_alphanumeric(c) && c != '_' && c != '-')
+                    return WebIDL::SimpleException { WebIDL::SimpleExceptionType::TypeError,
+                        "Invalid file picker ID"_utf16 };
+            }
+        }
+
+        auto const& settings = window.relevant_settings_object();
+        if (!window.is_secure_context() || settings.origin().is_opaque()
+            || !settings.top_level_origin.has_value()
+            || !settings.origin().is_same_origin(*settings.top_level_origin)
+            || !window.associated_document().is_fully_active()
+            || !window.has_transient_activation())
+            return WebIDL::SecurityError::create(
+                "A secure same-origin active document and user activation are required"_utf16);
+        return {};
+    }
+
+    WebIDL::ExceptionOr<void> apply_start_location(Window& window, JsonObject& request,
+        Optional<Variant<Bindings::WellKnownDirectory,
+            GC::Ref<FileSystemAccess::FileSystemHandle>>> const& start_in)
+    {
+        if (!start_in.has_value())
+            return {};
+        if (start_in->has<GC::Ref<FileSystemAccess::FileSystemHandle>>()) {
+            auto token = start_in->get<GC::Ref<FileSystemAccess::FileSystemHandle>>()->token_for(
+                window.associated_document());
+            if (!token.has_value())
+                return WebIDL::NotAllowedError::create(
+                    "The start handle belongs to another document"_utf16);
+            request.set("startHandle"sv, token.release_value());
+            return {};
+        }
+
+        request.set("startIn"sv,
+            Bindings::idl_enum_to_string(start_in->get<Bindings::WellKnownDirectory>())
+                .to_well_formed_utf8());
+        return {};
+    }
+
+    WebIDL::ExceptionOr<void> apply_filters(
+        JsonObject& request, Bindings::FilePickerOptions const& options)
+    {
+        auto invalid = [] {
+            return WebIDL::SimpleException { WebIDL::SimpleExceptionType::TypeError,
+                "Invalid file picker types"_utf16 };
+        };
+        JsonArray groups;
+        if (options.types.has_value()) {
+            if (options.types->size() > 16)
+                return WebIDL::QuotaExceededError::create("Too many file picker groups"_utf16);
+
+            for (auto const& type : *options.types) {
+                if (!type.accept.has_value() || type.accept->is_empty())
+                    continue;
+                if (type.accept->size() > 16)
+                    return WebIDL::QuotaExceededError::create(
+                        "Too many file picker media types"_utf16);
+
+                JsonArray extensions;
+                JsonArray mimes;
+                for (auto const& item : *type.accept) {
+                    auto mime = item.key.to_well_formed_utf8();
+                    auto parsed = MimeSniff::MimeType::parse(mime.bytes_as_string_view());
+                    if (mime.byte_count() > 127 || !parsed.has_value()
+                        || !parsed->parameters().is_empty() || mime.contains(';'))
+                        return invalid();
+
+                    auto add_suffix = [&](Utf16String const& suffix) -> WebIDL::ExceptionOr<void> {
+                        auto encoded = suffix.to_well_formed_utf8();
+                        auto extension = encoded.bytes_as_string_view();
+                        if (extension.length() < 2 || extension.length() > 16
+                            || !extension.starts_with('.') || extension.ends_with('.'))
+                            return invalid();
+                        for (auto character : extension) {
+                            if (!is_ascii_alphanumeric(character) && character != '.'
+                                && character != '+' && character != '-' && character != '_')
+                                return invalid();
+                        }
+                        if (extensions.size() >= 32)
+                            return WebIDL::QuotaExceededError::create(
+                                "Too many file picker extensions"_utf16);
+                        MUST(extensions.append(move(encoded)));
+                        return {};
+                    };
+
+                    if (item.value.has<Utf16String>()) {
+                        TRY(add_suffix(item.value.get<Utf16String>()));
+                    } else {
+                        auto const& suffixes = item.value.get<Vector<Utf16String>>();
+                        for (auto const& suffix : suffixes)
+                            TRY(add_suffix(suffix));
+                        if (suffixes.is_empty())
+                            MUST(mimes.append(parsed->essence()));
+                    }
+                }
+
+                auto description = type.description.to_well_formed_utf8();
+                if (description.byte_count() > 256)
+                    return WebIDL::QuotaExceededError::create(
+                        "File picker description is too long"_utf16);
+                JsonObject entry;
+                entry.set("extensions"sv, move(extensions));
+                entry.set("mimes"sv, move(mimes));
+                entry.set("description"sv, move(description));
+                MUST(groups.append(move(entry)));
+            }
+        }
+
+        if (options.exclude_accept_all_option && groups.is_empty())
+            return invalid();
+        request.set("excludeAcceptAllOption"sv, options.exclude_accept_all_option);
+        request.set("filterGroups"sv, move(groups));
+        return {};
+    }
+
+    void pick(Window& window, JsonObject options, GC::Ref<WebIDL::Promise> promise, bool as_array)
+    {
+        FileSystemAccess::request(window.associated_document(), move(options),
+            [document = GC::Root { window.associated_document() }, promise = GC::Root { promise },
+                as_array](JsonObject result, ByteBuffer) {
+                using namespace FileSystemAccess;
+                if (reject_if_failed(*promise, result))
+                    return;
+
+                auto grants = result.get_array("handles"sv);
+                if (!grants.has_value() || grants->is_empty()
+                    || (!as_array && grants->size() != 1)) {
+                    reject(*promise, "UnknownError"sv);
+                    return;
+                }
+
+                auto& realm = WebIDL::promise_realm(*promise);
+                TemporaryExecutionContext context(realm);
+                GC::RootVector<JS::Value> handles;
+                for (size_t i = 0; i < grants->size(); ++i) {
+                    auto const& grant = grants->at(i);
+                    auto handle = grant.is_object()
+                        ? FileSystemHandle::from_grant(*document, grant.as_object())
+                        : nullptr;
+                    if (!handle) {
+                        reject(*promise, "UnknownError"sv);
+                        return;
+                    }
+                    handles.append(Bindings::wrap(
+                        Bindings::host_defined_wrapper_world(realm), realm, GC::Ref { *handle }));
+                }
+
+                if (as_array)
+                    WebIDL::resolve_promise(
+                        *promise, JS::Array::create_from(realm, handles.span()));
+                else
+                    WebIDL::resolve_promise(*promise, handles[0]);
+            });
+    }
+}
+
+WebIDL::ExceptionOr<void> Window::show_open_file_picker(
+    Bindings::OpenFilePickerOptions const& options, GC::Ref<WebIDL::Promise> promise)
+{
+    TRY(check_picker(*this, options.id));
+    JsonObject request;
+    TRY(apply_start_location(*this, request, options.start_in));
+    if (options.id.has_value())
+        request.set("id"sv, options.id->to_well_formed_utf8());
+    TRY(apply_filters(request, options));
+    request.set("operation"sv, "open"sv);
+    request.set("multiple"sv, options.multiple);
+    pick(*this, move(request), promise, true);
+    return {};
+}
+
+WebIDL::ExceptionOr<void> Window::show_directory_picker(
+    Bindings::DirectoryPickerOptions const& options, GC::Ref<WebIDL::Promise> promise)
+{
+    TRY(check_picker(*this, options.id));
+    JsonObject request;
+    TRY(apply_start_location(*this, request, options.start_in));
+    if (options.id.has_value())
+        request.set("id"sv, options.id->to_well_formed_utf8());
+    request.set("operation"sv, "directory"sv);
+    request.set("writable"sv, options.mode == Bindings::FileSystemPermissionMode::Readwrite);
+    pick(*this, move(request), promise, false);
+    return {};
+}
+
+WebIDL::ExceptionOr<void> Window::show_save_file_picker(
+    Bindings::SaveFilePickerOptions const& options, GC::Ref<WebIDL::Promise> promise)
+{
+    TRY(check_picker(*this, options.id));
+    JsonObject request;
+    TRY(apply_start_location(*this, request, options.start_in));
+    if (options.id.has_value())
+        request.set("id"sv, options.id->to_well_formed_utf8());
+    TRY(apply_filters(request, options));
+    request.set("operation"sv, "save"sv);
+    if (options.suggested_name.has_value() && options.suggested_name->has_value())
+        request.set("suggestedName"sv, options.suggested_name->value().to_well_formed_utf8());
+    pick(*this, move(request), promise, false);
+    return {};
+}
+
+}
diff --git a/Libraries/LibWeb/FileSystemAccess/Provider.cpp b/Libraries/LibWeb/FileSystemAccess/Provider.cpp
new file mode 100644
index 00000000000..bfbb18b5e87
--- /dev/null
+++ b/Libraries/LibWeb/FileSystemAccess/Provider.cpp
@@ -0,0 +1,63 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibGC/Root.h>
+#include <LibJS/Runtime/Error.h>
+#include <LibJS/Runtime/Realm.h>
+#include <LibWeb/DOM/Document.h>
+#include <LibWeb/FileSystemAccess/Provider.h>
+#include <LibWeb/HTML/Scripting/TemporaryExecutionContext.h>
+#include <LibWeb/WebIDL/DOMException.h>
+
+namespace Web::FileSystemAccess {
+static Provider s_provider;
+
+void set_provider(Provider provider)
+{
+    s_provider = provider;
+}
+
+void request(DOM::Document& document, JsonObject options, Completion complete, ReadonlyBytes bytes)
+{
+    if (!s_provider) {
+        JsonObject result;
+        result.set("error"sv, "NotSupportedError"sv);
+        complete(move(result), {});
+        return;
+    }
+
+    auto& realm = document.relevant_settings_object().realm();
+    s_provider(document, move(options), bytes,
+        [realm = GC::Root { realm }, complete = move(complete)](JsonObject result, ByteBuffer data) {
+            // Native IPC delivery enters LibWeb from the event loop, outside any running script.
+            HTML::TemporaryExecutionContext context(*realm, HTML::TemporaryExecutionContext::CallbacksEnabled::Yes);
+            complete(move(result), move(data));
+        });
+}
+
+void reject(WebIDL::Promise const& promise, StringView name)
+{
+    auto& realm = WebIDL::promise_realm(promise);
+    HTML::TemporaryExecutionContext context(realm);
+    auto message = "The filesystem operation could not be completed."_utf16;
+    if (name == "TypeError"sv) {
+        WebIDL::reject_promise(promise, JS::TypeError::create(realm, message));
+        return;
+    }
+
+    WebIDL::reject_promise(
+        promise, WebIDL::DOMException::create(MUST(FlyString::from_utf8(name)), message));
+}
+
+bool reject_if_failed(WebIDL::Promise const& promise, JsonObject const& result)
+{
+    auto error = result.get_string("error"sv);
+    if (!error.has_value())
+        return false;
+
+    reject(promise, error->bytes_as_string_view());
+    return true;
+}
+
+}
