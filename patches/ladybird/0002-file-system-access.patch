+bool web_structured_serialize_file_system_handle(JSObject* object, void* context, void (*write)(void*, ReadonlyBytes))
+{
+    auto* wrappable = Bindings::wrappable_impl_from(JS::HostABI::object_from_abi(object));
+    auto* handle = dynamic_cast<FileSystemAccess::FileSystemHandle*>(wrappable);
+    if (!handle)
+        return false;
+    auto locator = handle->serialize_private_handle();
+    if (!locator.has_value())
+        return false;
+
+    write(context, locator->bytes());
+    return true;
+}
+
+JSObject* web_structured_deserialize_file_system_handle(u16 interface_name, void* raw_realm, ReadonlyBytes locator)
+{
+    auto& realm = realm_from_abi(raw_realm);
+    auto& environment = Bindings::principal_host_defined_environment_settings_object(realm);
+    Bindings::FileSystemHandleKind kind;
+    switch (static_cast<Bindings::InterfaceName>(interface_name)) {
+    case Bindings::InterfaceName::FileSystemDirectoryHandle:
+        kind = Bindings::FileSystemHandleKind::Directory;
+        break;
+    case Bindings::InterfaceName::FileSystemFileHandle:
+        kind = Bindings::FileSystemHandleKind::File;
+        break;
+    default:
+        return nullptr;
+    }
+
+    auto handle = FileSystemAccess::FileSystemHandle::deserialize_private_handle(environment, StringView(locator), kind);
+    if (!handle)
+        return nullptr;
+
+    auto wrapper = Bindings::wrap(Bindings::host_defined_wrapper_world(realm), realm, GC::Ref { *handle });
+    return JS::HostABI::object_to_abi(wrapper.ptr());
+}
