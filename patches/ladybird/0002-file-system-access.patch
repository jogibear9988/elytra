+FileSystemHandle::FileSystemHandle(
+    HTML::EnvironmentSettingsObject& environment, String token, Utf16String name, Bindings::FileSystemHandleKind kind)
+    : m_environment(environment)
+    , m_weak_environment(environment)
+    , m_token(move(token))
+    , m_name(move(name))
+    , m_kind(kind)
+{
+}
+
+void FileSystemHandle::visit_edges(GC::Cell::Visitor& visitor)
+{
+    Base::visit_edges(visitor);
+    visitor.visit(m_environment);
+}
+
+void FileSystemHandle::finalize()
+{
+    // GC finalization cannot enter the JavaScript VM or create new roots.
+    // Drop native leases from the event loop while the document is still live.
+    if (!m_token.is_empty() && Core::EventLoop::is_running()) {
+        Core::deferred_invoke([environment = move(m_weak_environment), token = move(m_token)] {
+            auto target = environment.ptr();
+            if (!target)
+                return;
+
+            JsonObject options;
+            options.set("operation"sv, "release"sv);
+            options.set("token"sv, token);
+            request(*target, move(options), [](JsonObject, ByteBuffer) { });
+        });
+    }
+    Base::finalize();
+}
+
+Optional<String> FileSystemHandle::token_for(DOM::Document const& document) const
+{
+    if (&document.relevant_settings_object() != m_environment.ptr())
+        return {};
+    if (m_token.is_empty())
+        return {};
+    return m_token;
+}
+
+GC::Ptr<FileSystemHandle> FileSystemHandle::from_grant(DOM::Document& document, JsonObject const& metadata)
+{
+    return from_grant(document.relevant_settings_object(), metadata);
+}
+
+GC::Ptr<FileSystemHandle> FileSystemHandle::from_grant(HTML::EnvironmentSettingsObject& environment, JsonObject const& metadata)
+{
+    auto name = metadata.get_string("name"sv);
+    auto token = metadata.get_string("token"sv);
+    auto kind = metadata.get_string("kind"sv);
+    if (!name.has_value() || !token.has_value() || !kind.has_value())
+        return nullptr;
+
+    auto& heap = GC::Heap::the();
+    GC::Ptr<FileSystemHandle> handle;
+    if (*kind == "file"sv)
+        handle = heap.allocate<FileSystemFileHandle>(environment, *token, Utf16String::from_utf8(*name));
+    else if (*kind == "directory"sv)
+        handle = heap.allocate<FileSystemDirectoryHandle>(environment, *token, Utf16String::from_utf8(*name));
+    if (auto path = metadata.get_array("privatePath"sv); handle && path.has_value())
+        handle->m_private_path = *path;
+    return handle;
+}
+
+Optional<String> FileSystemHandle::serialize_private_handle() const
+{
+    if (!m_private_path.has_value())
+        return {};
+    auto origin = environment().origin();
+    if (origin.is_opaque())
+        return {};
+
+    JsonObject metadata;
+    metadata.set("origin"sv, origin.serialize());
+    metadata.set("path"sv, *m_private_path);
+    return metadata.serialized();
+}
+
+GC::Ptr<FileSystemHandle> FileSystemHandle::deserialize_private_handle(HTML::EnvironmentSettingsObject& environment,
+    StringView payload, Bindings::FileSystemHandleKind kind)
+{
+    // No native path, permission, or live browser token is part of the record.
+    // Limit storage records before parsing or starting any filesystem operation.
+    if (payload.length() > 128 * 1024 || !HTML::is_secure_context(environment))
+        return nullptr;
+    auto parsed = JsonValue::from_string(payload);
+    if (parsed.is_error() || !parsed.value().is_object())
+        return nullptr;
+    auto const& metadata = parsed.value().as_object();
+    auto origin = metadata.get_string("origin"sv);
+    auto path = metadata.get_array("path"sv);
+    auto target = environment.origin();
+    if (!origin.has_value() || target.is_opaque() || *origin != target.serialize()
+        || !path.has_value() || path->size() > 64 || (path->is_empty() && kind == Bindings::FileSystemHandleKind::File))
+        return nullptr;
+
+    String name;
+    for (size_t i = 0; i < path->size(); ++i) {
+        auto const& value = path->at(i);
+        if (!value.is_string())
+            return nullptr;
+        name = value.as_string();
+        auto component = name.bytes_as_string_view();
+        if (component.is_empty() || component.is_one_of("."sv, ".."sv)
+            || component.length() > 255 || component.contains('/') || component.contains('\\')
+            || component.contains('\0') || component.starts_with(".elytra-file-"sv))
+            return nullptr;
+    }
+
+    JsonObject grant;
+    grant.set("name"sv, name);
+    grant.set("kind"sv, kind == Bindings::FileSystemHandleKind::File ? "file"sv : "directory"sv);
+    grant.set("token"sv, String {});
+    grant.set("privatePath"sv, path.release_value());
+    return from_grant(environment, grant);
+}
+
+void FileSystemHandle::with_native_token(TokenCallback callback)
+{
+    if (!m_token.is_empty()) {
+        callback(m_token, {});
+        return;
+    }
+
+    JsonObject options;
+    if (!m_private_path.has_value()) {
+        options.set("error"sv, "InvalidStateError"sv);
+        callback(Error::from_errno(EBADF), move(options));
+        return;
+    }
+
+    options.set("operation"sv, "reopenPrivate"sv);
+    options.set("kind"sv, kind() == Bindings::FileSystemHandleKind::File ? "file"sv : "directory"sv);
+    options.set("privatePath"sv, *m_private_path);
+    request(environment(), move(options), [self = GC::Root { *this }, callback = move(callback)](JsonObject result, ByteBuffer) {
+        auto token = result.get_string("token"sv);
+        if (!token.has_value()) {
+            if (!result.has("error"sv))
+                result.set("error"sv, "UnknownError"sv);
+            callback(Error::from_errno(EIO), move(result));
+            return;
+        }
+
+        if (self->m_token.is_empty()) {
+            self->m_token = token.release_value();
+        } else {
+            JsonObject release;
+            release.set("operation"sv, "release"sv);
+            release.set("token"sv, token.release_value());
+            request(self->environment(), move(release), [](JsonObject, ByteBuffer) { });
+        }
+        callback(self->m_token, {});
+    });
+}
+
+void FileSystemHandle::request_handle(JsonObject options, Completion completion, FileSystemHandle* other)
+{
+    with_native_token([self = GC::Root { *this }, other = GC::Root { other },
+                          options = move(options), completion = move(completion)](ErrorOr<String> token, JsonObject error) mutable {
+        if (token.is_error()) {
+            completion(move(error), {});
+            return;
+        }
+        options.set("token"sv, token.release_value());
+        if (!other) {
+            request(self->environment(), move(options), move(completion));
+            return;
+        }
+
+        other->with_native_token([self = move(self), options = move(options), completion = move(completion)](
+                                      ErrorOr<String> token, JsonObject error) mutable {
+            if (token.is_error()) {
+                completion(move(error), {});
+                return;
+            }
+            options.set("other"sv, token.release_value());
+            request(self->environment(), move(options), move(completion));
+        });
+    });
+}
