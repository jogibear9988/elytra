+#[derive(Trace)]
+#[gc(crate = libjs_rust)]
+pub(crate) struct FileSystemWritableFileStream {
+    stream: Ref<WritableStream>,
+}
+
+impl Wrappable for FileSystemWritableFileStream {}
+
+impl Inherits<WritableStream> for FileSystemWritableFileStream {
+    fn parent(&self) -> &WritableStream {
+        &self.stream
+    }
+}
+
+impl FileSystemWritableFileStream {
+    pub(crate) fn stream(&self) -> Ref<WritableStream> {
+        self.stream
+    }
+
+    pub(crate) fn write(this: &Ref<Self>, cx: &mut CallContext, data: Value) -> WebIdlResult<WebIdlPromise> {
+        let writer = WritableStream::get_writer(&this.stream, cx)?;
+        let result = WritableStreamDefaultWriter::write(&writer, cx, Some(data));
+        WritableStreamDefaultWriter::release_lock(&writer, cx)?;
+        result
+    }
+
+    pub(crate) fn seek(this: &Ref<Self>, cx: &mut CallContext, position: u64) -> WebIdlResult<WebIdlPromise> {
+        Self::command(this, cx, b"seek", "position", position)
+    }
+
+    pub(crate) fn truncate(this: &Ref<Self>, cx: &mut CallContext, size: u64) -> WebIdlResult<WebIdlPromise> {
+        Self::command(this, cx, b"truncate", "size", size)
+    }
+
+    fn command(
+        this: &Ref<Self>,
+        cx: &mut CallContext,
+        kind: &[u8],
+        field: &str,
+        value: u64,
+    ) -> WebIdlResult<WebIdlPromise> {
+        let vm = cx.vm();
+        let command = Object::create(vm, cx.realm(), None);
+        let kind = Value::from_string(PrimitiveString::create_from_ascii(vm, kind));
+        command.create_data_property(vm, &vm.names.type_, kind, None, None)?;
+        command.create_data_property(
+            vm,
+            &PropertyKey::from_utf8(field),
+            Value::from_f64(value as f64),
+            None,
+            None,
+        )?;
+        Self::write(this, cx, Value::from_object(command))
+    }
+}
+
+// SAFETY: The caller passes the VM, a live realm, and a JS object in that realm with the three internal sink callbacks.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn web_rust_file_system_writable_file_stream_create(
+    vm: *mut c_void,
+    realm: *mut c_void,
+    sink: u64,
+) -> *mut c_void {
+    let (vm, realm) = unsafe { realm_arguments(vm, realm) };
+    let sink = unsafe { Value::from_raw(sink) };
+    let stream = WritableStream::create(vm, realm);
+    let cx = CallContext::new(vm, realm);
+    if WritableStream::set_up_using_sink(stream, &cx, sink).is_err() {
+        return core::ptr::null_mut();
+    }
+    let stream = allocate(vm, |_| FileSystemWritableFileStream { stream });
+    cell_into_abi(stream)
+}
