+void* web_storage_api_get_directory(void* raw_realm)
+{
+    auto& realm = *static_cast<JS::Realm*>(raw_realm);
+    auto promise = WebIDL::create_promise(realm);
+    auto* window = HTML::window_from_global_object(realm.global_object());
+    if (!window || !window->associated_document().is_fully_active()) {
+        FileSystemAccess::reject(*promise, "InvalidStateError"sv);
+        return promise.ptr();
+    }
+
+    auto& document = window->associated_document();
+    JsonObject request;
+    request.set("operation"sv, "getPrivateDirectory"sv);
+    FileSystemAccess::request(document, move(request),
+        [document = GC::Root { document }, promise = GC::Root { promise }](
+            JsonObject result, ByteBuffer) {
+            if (FileSystemAccess::reject_if_failed(*promise, result))
+                return;
+
+            auto handle = FileSystemAccess::FileSystemHandle::from_grant(*document, result);
+            if (!handle || handle->kind() != Bindings::FileSystemHandleKind::Directory) {
+                FileSystemAccess::reject(*promise, "UnknownError"sv);
+                return;
+            }
+
+            auto& realm = WebIDL::promise_realm(*promise);
+            WebIDL::resolve_promise(*promise,
+                Bindings::wrap(
+                    Bindings::host_defined_wrapper_world(realm), realm, GC::Ref { *handle }));
+        });
+    return promise.ptr();
+}
+
 }
