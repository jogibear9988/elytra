diff --git a/Libraries/LibWeb/FileSystemAccess/SyncAccess.cpp b/Libraries/LibWeb/FileSystemAccess/SyncAccess.cpp
new file mode 100644
index 00000000000..2c0b79bf674
--- /dev/null
+++ b/Libraries/LibWeb/FileSystemAccess/SyncAccess.cpp
@@ -0,0 +1,187 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibCore/EventLoop.h>
+#include <LibGC/Root.h>
+#include <LibJS/Runtime/ArrayBuffer.h>
+#include <LibWeb/Bindings/FileSystemFileHandle.h>
+#include <LibWeb/Bindings/FileSystemSyncAccessHandle.h>
+#include <LibWeb/Bindings/WrapperWorld.h>
+#include <LibWeb/FileSystemAccess/FileSystemFileHandle.h>
+#include <LibWeb/FileSystemAccess/FileSystemSyncAccessHandle.h>
+#include <LibWeb/FileSystemAccess/Provider.h>
+#include <LibWeb/HTML/Scripting/Environments.h>
+#include <LibWeb/WebIDL/DOMException.h>
+
+namespace Web::FileSystemAccess {
+
+GC_DEFINE_ALLOCATOR(FileSystemSyncAccessHandle);
+
+FileSystemSyncAccessHandle::FileSystemSyncAccessHandle(HTML::EnvironmentSettingsObject& environment,
+    FileSystemFileHandle& file, String token)
+    : m_environment(environment)
+    , m_weak_environment(environment)
+    , m_file(file)
+    , m_token(move(token))
+{
+}
+
+void FileSystemSyncAccessHandle::visit_edges(GC::Cell::Visitor& visitor)
+{
+    Base::visit_edges(visitor);
+    visitor.visit(m_environment);
+    visitor.visit(m_file);
+}
+
+void FileSystemSyncAccessHandle::finalize()
+{
+    if (!m_token.is_empty() && Core::EventLoop::is_running()) {
+        Core::deferred_invoke([environment = move(m_weak_environment), token = move(m_token)] {
+            if (auto live = environment.ptr()) {
+                JsonObject metadata;
+                metadata.set("operation"sv, "syncClose"sv);
+                metadata.set("token"sv, token);
+                (void)request_from_worker(*live, move(metadata));
+            }
+        });
+    }
+
+    Base::finalize();
+}
+
+static WebIDL::Exception error(StringView name)
+{
+    if (name == "TypeError"sv)
+        return WebIDL::SimpleException { WebIDL::SimpleExceptionType::TypeError, "Invalid synchronous filesystem request"_utf16 };
+    return WebIDL::DOMException::create(MUST(FlyString::from_utf8(name)), "The synchronous filesystem operation failed"_utf16);
+}
+
+WebIDL::ExceptionOr<FileSystemSyncAccessHandle::Result> FileSystemSyncAccessHandle::call(
+    StringView operation, JsonObject metadata, ReadonlyBytes bytes)
+{
+    if (m_token.is_empty())
+        return error("InvalidStateError"sv);
+
+    metadata.set("operation"sv, operation);
+    metadata.set("token"sv, m_token);
+    auto result = request_from_worker(*m_environment, move(metadata), bytes);
+    if (!result.has_value() || !result->metadata.is_object())
+        return error("InvalidStateError"sv);
+
+    auto& response = result->metadata.as_object();
+    if (auto name = response.get_string("error"sv); name.has_value())
+        return error(name->bytes_as_string_view());
+    return Result { move(response), move(result->bytes) };
+}
+
+void FileSystemSyncAccessHandle::close()
+{
+    if (m_token.is_empty())
+        return;
+    (void)call("syncClose"sv);
+    m_token = {};
+}
+
+WebIDL::ExceptionOr<void> FileSystemSyncAccessHandle::flush()
+{
+    TRY(call("syncFlush"sv));
+    return {};
+}
+
+WebIDL::ExceptionOr<void> FileSystemSyncAccessHandle::truncate(u64 size)
+{
+    JsonObject metadata;
+    metadata.set("size"sv, size);
+    TRY(call("syncTruncate"sv, move(metadata)));
+    m_cursor = min(m_cursor, size);
+    return {};
+}
+
+WebIDL::ExceptionOr<u64> FileSystemSyncAccessHandle::get_size()
+{
+    auto result = TRY(call("syncSize"sv));
+    auto size = result.metadata.get_u64("size"sv);
+    if (!size.has_value())
+        return error("UnknownError"sv);
+    return *size;
+}
+
+WebIDL::ExceptionOr<u64> FileSystemSyncAccessHandle::read(
+    WebIDL::BufferSource const& buffer, Bindings::FileSystemReadWriteOptions const& options)
+{
+    return transfer(buffer, options.at, false);
+}
+
+WebIDL::ExceptionOr<u64> FileSystemSyncAccessHandle::write(
+    WebIDL::BufferSource const& buffer, Bindings::FileSystemReadWriteOptions const& options)
+{
+    return transfer(buffer, options.at, true);
+}
+
+WebIDL::ExceptionOr<u64> FileSystemSyncAccessHandle::transfer(
+    WebIDL::BufferSource const& source, Optional<u64> offset, bool writing)
+{
+    if (m_token.is_empty())
+        return error("InvalidStateError"sv);
+
+    auto validated = WebIDL::validate_buffer_source(source);
+    if (validated.is_error())
+        return error("TypeError"sv);
+    auto buffer = validated.release_value();
+    auto start = offset.value_or(m_cursor);
+    if (start > NumericLimits<u64>::max() - buffer.byte_length)
+        return error("TypeError"sv);
+    size_t processed = 0;
+    for (;;) {
+        constexpr size_t chunk_size = 256 * 1024;
+        auto count = min(chunk_size, buffer.byte_length - processed);
+        JsonObject metadata;
+        metadata.set("offset"sv, start + processed);
+        metadata.set("count"sv, static_cast<u64>(count));
+        if (writing) {
+            auto data = buffer.buffer->copy_to_byte_buffer(buffer.byte_offset + processed, count);
+            if (data.is_error())
+                return error("QuotaExceededError"sv);
+            TRY(call("syncWrite"sv, move(metadata), data.value().bytes()));
+            processed += count;
+        } else {
+            auto result = TRY(call("syncRead"sv, move(metadata)));
+            auto size = result.bytes.size();
+            if (size > count)
+                return error("UnknownError"sv);
+            if (size)
+                buffer.buffer->overwrite(buffer.byte_offset + processed, result.bytes.data(), size);
+            processed += size;
+            if (size < count)
+                break;
+        }
+        if (processed == buffer.byte_length)
+            break;
+    }
+    m_cursor = start + processed;
+    return processed;
+}
+
+WebIDL::ExceptionOr<void> FileSystemFileHandle::create_sync_access_handle(
+    Bindings::FileSystemCreateSyncAccessHandleOptions const& options, GC::Ref<WebIDL::Promise> promise)
+{
+    JsonObject metadata;
+    metadata.set("operation"sv, "syncOpen"sv);
+    metadata.set("mode"sv, Bindings::idl_enum_to_string(options.mode).to_well_formed_utf8());
+    request_handle(move(metadata), [self = GC::Root { *this }, promise = GC::Root { promise }](JsonObject response, ByteBuffer) {
+        if (reject_if_failed(*promise, response))
+            return;
+        auto token = response.get_string("sync"sv);
+        if (!token.has_value()) {
+            reject(*promise, "UnknownError"sv);
+            return;
+        }
+        auto& realm = WebIDL::promise_realm(*promise);
+        auto handle = realm.create<FileSystemSyncAccessHandle>(self->environment(), *self, *token);
+        WebIDL::resolve_promise(*promise, Bindings::wrap(Bindings::host_defined_wrapper_world(realm), realm, handle));
+    });
+    return {};
+}
+
+}
diff --git a/Libraries/LibWeb/FileSystemAccess/Writable.cpp b/Libraries/LibWeb/FileSystemAccess/Writable.cpp
new file mode 100644
index 00000000000..4206728199f
--- /dev/null
+++ b/Libraries/LibWeb/FileSystemAccess/Writable.cpp
@@ -0,0 +1,257 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibGC/Function.h>
+#include <LibGC/Heap.h>
+#include <LibGC/Root.h>
+#include <LibJS/HostClassBuilder.h>
+#include <LibJS/Runtime/ArrayBuffer.h>
+#include <LibJS/Runtime/DataView.h>
+#include <LibJS/Runtime/Error.h>
+#include <LibJS/Runtime/Realm.h>
+#include <LibJS/Runtime/TypedArray.h>
+#include <LibJS/Runtime/VM.h>
+#include <LibJS/Runtime/ValueInlines.h>
+#include <LibWeb/Bindings/FileSystemFileHandle.h>
+#include <LibWeb/Bindings/WrapperWorld.h>
+#include <LibWeb/DOM/Document.h>
+#include <LibWeb/FileAPI/Blob.h>
+#include <LibWeb/FileSystemAccess/FileSystemFileHandle.h>
+#include <LibWeb/FileSystemAccess/Provider.h>
+#include <LibWeb/HTML/Scripting/TemporaryExecutionContext.h>
+#include <LibWeb/HTML/Scripting/Environments.h>
+#include <LibWeb/Streams/FileSystemWritableFileStream.h>
+#include <LibWeb/WebIDL/AbstractOperations.h>
+
+namespace Web::FileSystemAccess {
+
+extern "C" void* web_rust_file_system_writable_file_stream_create(JSVM*, void* realm, JSValue sink);
+
+class WriteSession final : public GC::Cell {
+    GC_CELL(WriteSession, GC::Cell);
+    GC_DECLARE_ALLOCATOR(WriteSession);
+
+public:
+    WriteSession(HTML::EnvironmentSettingsObject& environment, FileSystemFileHandle& handle, String token)
+        : m_environment(environment)
+        , m_handle(handle)
+        , m_token(move(token))
+    {
+    }
+
+    JS::ThrowCompletionOr<JS::Value> write(JS::VM&);
+    GC::Ref<WebIDL::Promise> finish(JS::Realm&, bool commit);
+
+private:
+    virtual void visit_edges(GC::Cell::Visitor& visitor) override
+    {
+        Base::visit_edges(visitor);
+        visitor.visit(m_environment);
+        visitor.visit(m_handle);
+    }
+
+    void send(JsonObject, GC::Ref<WebIDL::Promise>, ReadonlyBytes = {});
+    void write_bytes(GC::Root<WebIDL::Promise>, ByteBuffer, size_t written);
+
+    GC::Ref<HTML::EnvironmentSettingsObject> m_environment;
+    GC::Ref<FileSystemFileHandle> m_handle;
+    String m_token;
+    u64 m_position { 0 };
+};
+
+GC_DEFINE_ALLOCATOR(WriteSession);
+
+void WriteSession::send(JsonObject options, GC::Ref<WebIDL::Promise> promise, ReadonlyBytes bytes)
+{
+    options.set("token"sv, m_token);
+    request(
+        *m_environment, move(options),
+        [promise = GC::Root { promise }](JsonObject result, ByteBuffer) {
+            if (!reject_if_failed(*promise, result))
+                WebIDL::resolve_promise(*promise);
+        },
+        bytes);
+}
+
+GC::Ref<WebIDL::Promise> WriteSession::finish(JS::Realm& realm, bool commit)
+{
+    auto promise = WebIDL::create_promise(realm);
+    JsonObject options;
+    options.set("operation"sv, commit ? "closeWriter"sv : "abortWriter"sv);
+    send(move(options), promise);
+    return promise;
+}
+
+void WriteSession::write_bytes(
+    GC::Root<WebIDL::Promise> promise, ByteBuffer contents, size_t written)
+{
+    if (written == contents.size()) {
+        WebIDL::resolve_promise(*promise);
+        return;
+    }
+
+    auto count = min(contents.size() - written, size_t { 256 * 1024 });
+    if (m_position > NumericLimits<u64>::max() - count) {
+        reject(*promise, "TypeError"sv);
+        return;
+    }
+
+    JsonObject options;
+    options.set("operation"sv, "write"sv);
+    options.set("token"sv, m_token);
+    options.set("offset"sv, m_position);
+    // The provider copies this view before the callback takes ownership of the backing buffer.
+    auto bytes = MUST(ByteBuffer::copy(contents.bytes().slice(written, count)));
+    request(
+        *m_environment, move(options),
+        [session = GC::Root { *this }, promise = move(promise), contents = move(contents), written,
+            count](JsonObject result, ByteBuffer) mutable {
+            if (reject_if_failed(*promise, result))
+                return;
+
+            session->m_position += count;
+            session->write_bytes(move(promise), move(contents), written + count);
+        },
+        bytes.bytes());
+}
+
+static JS::ThrowCompletionOr<u64> position_from(JS::VM& vm, JS::Value value)
+{
+    auto number = TRY(value.to_number(vm)).as_double();
+    if (!isfinite(number) || number < 0 || number >= 0x1p64)
+        return vm.throw_completion<JS::TypeError>("Invalid file offset"_utf16);
+    return static_cast<u64>(number);
+}
+
+JS::ThrowCompletionOr<JS::Value> WriteSession::write(JS::VM& vm)
+{
+    auto& realm = *vm.current_realm();
+    auto promise = WebIDL::create_promise(realm);
+    auto value = vm.argument(0);
+    auto data = value;
+    GC::Ptr<FileAPI::Blob> blob;
+    auto is_buffer = [](JS::Value candidate) {
+        return candidate.is_object()
+            && (is<JS::ArrayBuffer>(candidate.as_object())
+                || is<JS::TypedArrayBase>(candidate.as_object())
+                || is<JS::DataView>(candidate.as_object()));
+    };
+
+    if (value.is_object() && !is_buffer(value)) {
+        blob = Bindings::impl_from<FileAPI::Blob>(&value.as_object());
+        if (!blob) {
+            auto type = TRY(value.as_object().get("type"_utf16));
+            auto command = TRY(type.to_utf16_string(vm));
+            if (command == "seek"_utf16) {
+                auto offset = TRY(position_from(vm, TRY(value.as_object().get("position"_utf16))));
+                m_position = offset;
+                WebIDL::resolve_promise(*promise);
+                return promise->promise();
+            }
+
+            if (command == "truncate"_utf16) {
+                auto size = TRY(position_from(vm, TRY(value.as_object().get("size"_utf16))));
+                JsonObject options;
+                options.set("operation"sv, "truncate"sv);
+                options.set("size"sv, size);
+                options.set("token"sv, m_token);
+                request(*m_environment, move(options),
+                    [session = GC::Root { *this }, promise = GC::Root { promise }, size](
+                        JsonObject result, ByteBuffer) {
+                        if (!reject_if_failed(*promise, result)) {
+                            session->m_position = min(session->m_position, size);
+                            WebIDL::resolve_promise(*promise);
+                        }
+                    });
+                return promise->promise();
+            }
+
+            if (command != "write"_utf16)
+                return vm.throw_completion<JS::TypeError>("Invalid file write command"_utf16);
+            auto offset = TRY(value.as_object().get("position"_utf16));
+            if (!offset.is_nullish())
+                m_position = TRY(position_from(vm, offset));
+            data = TRY(value.as_object().get("data"_utf16));
+            if (data.is_nullish())
+                return vm.throw_completion<JS::TypeError>("Missing file write data"_utf16);
+            if (data.is_object())
+                blob = Bindings::impl_from<FileAPI::Blob>(&data.as_object());
+        }
+    }
+
+    auto bytes = [](JS::VM& vm, JS::Value data, GC::Ptr<FileAPI::Blob> blob,
+                     bool buffer) -> JS::ThrowCompletionOr<ErrorOr<ByteBuffer>> {
+        if (blob)
+            return ByteBuffer::copy(blob->raw_bytes());
+        if (buffer)
+            return WebIDL::get_buffer_source_copy(data.as_object());
+
+        auto input = TRY(data.to_utf16_string(vm)).to_well_formed_utf8();
+        return ByteBuffer::copy(input.bytes());
+    }(vm, data, blob, is_buffer(data));
+    auto buffer = TRY(move(bytes));
+    if (buffer.is_error())
+        reject(*promise, "QuotaExceededError"sv);
+    else
+        write_bytes(GC::Root { promise }, buffer.release_value(), 0);
+    return promise->promise();
+}
+
+WebIDL::ExceptionOr<void> FileSystemFileHandle::create_writable(
+    Bindings::FileSystemCreateWritableOptions const& options, GC::Ref<WebIDL::Promise> promise)
+{
+    JsonObject metadata;
+    metadata.set("operation"sv, "beginWrite"sv);
+    metadata.set("keepExistingData"sv, options.keep_existing_data);
+    request_handle(move(metadata),
+        [environment = GC::Root { environment() }, handle = GC::Root { *this },
+            promise = GC::Root { promise }](JsonObject result, ByteBuffer) {
+            if (reject_if_failed(*promise, result))
+                return;
+
+            auto writer = result.get_string("writer"sv);
+            if (!writer.has_value()) {
+                reject(*promise, "UnknownError"sv);
+                return;
+            }
+
+            auto& realm = WebIDL::promise_realm(*promise);
+            HTML::TemporaryExecutionContext context(
+                realm, HTML::TemporaryExecutionContext::CallbacksEnabled::Yes);
+            GC::Root session { realm.heap().allocate<WriteSession>(*environment, *handle, *writer) };
+            auto sink = JS::Object::create(realm, nullptr);
+            auto write = GC::create_function<JS::ThrowCompletionOr<JS::Value>(JS::VM&)>(
+                realm.heap(), GC::captures(GC::Ref { *session }),
+                [](auto& session, auto& vm) { return session->write(vm); });
+            sink->define_native_function(realm, "write"_utf16, write, 1, JS::default_attributes);
+
