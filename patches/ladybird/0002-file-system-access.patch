diff --git a/Libraries/LibWeb/FileSystemAccess/FileSystemDirectoryHandleAsyncIterator.cpp b/Libraries/LibWeb/FileSystemAccess/FileSystemDirectoryHandleAsyncIterator.cpp
new file mode 100644
index 00000000000..c3322021c98
--- /dev/null
+++ b/Libraries/LibWeb/FileSystemAccess/FileSystemDirectoryHandleAsyncIterator.cpp
@@ -0,0 +1,173 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibJS/HostClassBuilder.h>
+#include <LibJS/Runtime/Array.h>
+#include <LibJS/Runtime/PrimitiveString.h>
+#include <LibWeb/Bindings/FileSystemDirectoryHandle.h>
+#include <LibWeb/Bindings/Intrinsics.h>
+#include <LibWeb/Bindings/WrapperWorld.h>
+#include <LibWeb/DOM/Document.h>
+#include <LibWeb/FileSystemAccess/FileSystemDirectoryHandle.h>
+#include <LibWeb/FileSystemAccess/FileSystemDirectoryHandleAsyncIterator.h>
+#include <LibWeb/FileSystemAccess/Provider.h>
+#include <LibWeb/HTML/Scripting/TemporaryExecutionContext.h>
+
+namespace Web::FileSystemAccess {
+
+GC_DEFINE_ALLOCATOR(FileSystemDirectoryHandleAsyncIterator);
+
+static constexpr JSHostClass iterator_host_class = JS::make_host_class(
+    JS_HOST_CLASS_OBJECT, "FileSystemDirectoryHandleAsyncIterator"sv, nullptr, nullptr, nullptr, 0);
+
+GC::Ref<JS::HostObject> FileSystemDirectoryHandleAsyncIterator::create(JS::Realm& realm,
+    JS::Object::PropertyKind kind, FileSystemDirectoryHandle& directory)
+{
+    auto iterator = realm.create<FileSystemDirectoryHandleAsyncIterator>(realm, kind, directory);
+    auto& prototype = Bindings::ensure_web_prototype<Bindings::FileSystemDirectoryHandleAsyncIteratorPrototype>(
+        realm, "FileSystemDirectoryHandleAsyncIterator"_utf16_fly_string);
+    return JS::HostObject::create(realm, iterator_host_class, prototype, {}, iterator);
+}
+
+FileSystemDirectoryHandleAsyncIterator::FileSystemDirectoryHandleAsyncIterator(JS::Realm& realm,
+    JS::Object::PropertyKind kind, FileSystemDirectoryHandle& directory)
+    : WebIDL::AsyncIterator(realm, kind)
+    , m_directory(directory)
+    , m_kind(kind)
+{
+}
+
+void FileSystemDirectoryHandleAsyncIterator::visit_edges(GC::Cell::Visitor& visitor)
+{
+    Base::visit_edges(visitor);
+    visitor.visit(m_directory);
+}
+
+GC::Ref<WebIDL::Promise> FileSystemDirectoryHandleAsyncIterator::next_iteration_result(JS::Realm& realm)
+{
+    auto promise = WebIDL::create_promise(realm);
+    step(GC::Root { promise });
+    return promise;
+}
+
+GC::Ref<WebIDL::Promise> FileSystemDirectoryHandleAsyncIterator::iterator_return(JS::Realm& realm, JS::Value)
+{
+    auto promise = WebIDL::create_promise(realm);
+    if (m_cursor.has_value()) {
+        JsonObject options;
+        options.set("operation"sv, "closeIterator"sv);
+        options.set("token"sv, m_cursor.release_value());
+        request(m_directory->environment(), move(options), [promise = GC::Root { promise }](JsonObject result, ByteBuffer) {
+            if (!reject_if_failed(*promise, result))
+                WebIDL::resolve_promise(*promise);
+        });
+    } else {
+        WebIDL::resolve_promise(*promise);
+    }
+    return promise;
+}
+
+void FileSystemDirectoryHandleAsyncIterator::step(GC::Root<WebIDL::Promise> promise)
+{
+    if (m_index < m_entries.size()) {
+        auto const& entry = m_entries.at(m_index++);
+        if (entry.is_object())
+            resolve_entry(move(promise), entry.as_object());
+        else
+            reject(*promise, "UnknownError"sv);
+        return;
+    }
+
+    if (m_done) {
+        WebIDL::resolve_promise(*promise, JS::js_special_empty_value());
+        return;
+    }
+
+    JsonObject options;
+    if (!m_cursor.has_value()) {
+        options.set("operation"sv, "iterate"sv);
+        m_directory->request_handle(move(options), [self = GC::Root { *this }, promise = move(promise)](JsonObject result, ByteBuffer) mutable {
+            if (reject_if_failed(*promise, result))
+                return;
+            auto cursor = result.get_string("cursor"sv);
+            if (!cursor.has_value()) {
+                reject(*promise, "UnknownError"sv);
+                return;
+            }
+
+            self->m_cursor = *cursor;
+            self->step(move(promise));
+        });
+        return;
+    }
+
+    options.set("operation"sv, "nextEntries"sv);
+    options.set("token"sv, *m_cursor);
+    request(m_directory->environment(), move(options), [self = GC::Root { *this }, promise = move(promise)](JsonObject result, ByteBuffer) mutable {
+        if (reject_if_failed(*promise, result))
+            return;
+        auto entries = result.get_array("entries"sv);
+        auto done = result.get_bool("done"sv);
+        if (!entries.has_value() || !done.has_value()) {
+            reject(*promise, "UnknownError"sv);
+            return;
+        }
+
+        self->m_entries = move(*entries);
+        self->m_index = 0;
+        self->m_done = *done;
+        if (*done)
+            self->m_cursor.clear();
+        self->step(move(promise));
+    });
+}
+
+void FileSystemDirectoryHandleAsyncIterator::resolve_entry(GC::Root<WebIDL::Promise> promise, JsonObject const& entry)
+{
+    auto name = entry.get_string("name"sv);
+    auto kind = entry.get_string("kind"sv);
+    if (!name.has_value() || !kind.has_value()) {
+        reject(*promise, "UnknownError"sv);
+        return;
+    }
+
+    if (m_kind == JS::Object::PropertyKind::Key) {
+        auto& realm = WebIDL::promise_realm(*promise);
+        HTML::TemporaryExecutionContext context(realm);
+        WebIDL::resolve_promise(*promise, JS::PrimitiveString::create(realm.vm(), Utf16String::from_utf8(*name)));
+        return;
+    }
+
+    JsonObject options;
+    options.set("operation"sv, "child"sv);
+    options.set("name"sv, *name);
+    options.set("kind"sv, *kind);
+    m_directory->request_handle(move(options), [self = GC::Root { *this }, promise = move(promise)](JsonObject result, ByteBuffer) mutable {
+        if (auto error = result.get_string("error"sv); error.has_value() && *error == "NotFoundError"sv) {
+            self->step(move(promise));
+            return;
+        }
+
+        if (reject_if_failed(*promise, result))
+            return;
+        auto handle = FileSystemHandle::from_grant(self->m_directory->environment(), result);
+        if (!handle) {
+            reject(*promise, "UnknownError"sv);
+            return;
+        }
+
+        auto& realm = WebIDL::promise_realm(*promise);
+        HTML::TemporaryExecutionContext context(realm);
+        auto wrapper = Bindings::wrap(Bindings::host_defined_wrapper_world(realm), realm, GC::Ref { *handle });
+        if (self->m_kind == JS::Object::PropertyKind::Value) {
+            WebIDL::resolve_promise(*promise, wrapper);
+            return;
+        }
+
+        auto key = JS::PrimitiveString::create(realm.vm(), handle->name());
+        WebIDL::resolve_promise(*promise, JS::Array::create_from(realm, { key, wrapper }));
+    });
+}
+
+}
