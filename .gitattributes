# Integrity manifests hash these exact bytes. Keep them stable on Windows too.
/tooling/runtime-js/** text eol=lf
/mite/modules/generated/** text eol=lf

# Authored ESM sources also participate in the bootstrap integrity manifest.
/mite/modules/** text eol=lf
/mite/runtime/bootstrap/** text eol=lf

/firefly/core/** text eol=lf
/firefly/native/qt/app-regions.mjs text eol=lf

# Pinned compatibility source/license checksums must survive native Windows checkout.
/vendor/code-oss-tests/** text eol=lf
/vendor/node-url/** text eol=lf
/vendor/policy-watcher/** text eol=lf
# Preserve the upstream license verbatim, including its space-before-tab line.
/vendor/node-url/LICENSE -whitespace

# npm deviceid includes CRLF files; preserve exact upstream integrity/license bytes.
/vendor/deviceid/** -text -whitespace
